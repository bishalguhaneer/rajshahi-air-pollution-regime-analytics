* Encoding: UTF-8.
COMPUTE LN_PM25=LN(PM2.5_DailyMean).
EXECUTE.

COMPUTE LN_NO2=LN(NO2_DailyMean).
EXECUTE.

COMPUTE LN_CO=LN(CO_DailyMean).
EXECUTE.

COMPUTE LN_O3=LN(O3_DailyMean).
EXECUTE.


EXAMINE VARIABLES=LN_PM25 LN_NO2 LN_CO LN_O3
  /PLOT BOXPLOT HISTOGRAM NPPLOT
  /COMPARE GROUPS
  /STATISTICS DESCRIPTIVES EXTREME
  /CINTERVAL 95
  /MISSING LISTWISE
  /NOTOTAL.

GRAPH
  /SCATTERPLOT(MATRIX)=LN_PM25 LN_NO2 LN_CO LN_O3
  /MISSING=LISTWISE.
